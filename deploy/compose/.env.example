# Copy to .env next to docker-compose.yml.

# Required: 32 random bytes, base64. Encrypts signing keys at rest; losing it
# means re-issuing every key. Generate with: openssl rand -base64 32
HAYAT_MASTER_KEY=

# The public address of the auth role. Must be https:// unless HAYAT_DEV=true.
HAYAT_ISSUER=http://localhost:8443
# Where the console is served. Its /callback becomes the console client's redirect URI.
HAYAT_CONSOLE_URL=http://localhost:3000
# Development only: allows an http issuer and http redirect URIs.
HAYAT_DEV=true

# This deployment's home region. v1 runs one region.
HAYAT_REGION=default
# postgres (default) or yugabyte; picks the migration history.
HAYAT_DATABASE_ENGINE=postgres

# Outgoing mail. Compose points it at mailpit; set a real relay in production.
# HAYAT_SMTP_URL=smtp://user:pass@smtp.example.com:587
HAYAT_MAIL_FROM=Hayat <no-reply@example.com>

# Listen addresses (defaults shown).
# HAYAT_AUTH_ADDR=:8443
# HAYAT_ADMIN_ADDR=:8080
# HAYAT_API_ADDR=:7443
# HAYAT_HEALTH_ADDR=:9090

# Lifetimes (Go durations).
# HAYAT_SESSION_TTL=336h
# HAYAT_ACCESS_TOKEN_TTL=10m
# HAYAT_REFRESH_TOKEN_TTL=720h
# HAYAT_KEY_ROTATION=2160h

POSTGRES_PASSWORD=hayat
